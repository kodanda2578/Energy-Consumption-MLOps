# Energy Consumption MLOps Environment Configuration

# Standalone Deployment Model (Production recommended: loads without mlflow.db or mlruns)
MODEL_PATH=deployment_model
MODEL_NAME=EnergyConsumptionModel
MODEL_ALIAS=champion
MLFLOW_DISABLE_AGENT_HINT=1

# Production CORS Configuration (comma-separated allowed origins, or *)
CORS_ORIGINS=http://localhost:5173,http://localhost:5175
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$|^https://.*\.vercel\.app$

# MLflow Tracking & Registry Configuration (Local development & experimentation fallback)
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_ALLOW_FILE_STORE=true

# Server Hosting Configuration
API_HOST=0.0.0.0
API_PORT=8000
PORT=8000
